.env
.env.*

# macOS
.DS_Store

# Editor (shared launch/settings are tracked; personal state is not)
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Rendered UI screenshots (scripts/render_ui_states.py)
ui-review/
